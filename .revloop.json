{
  "$schema": "https://raw.githubusercontent.com/iwmaeda/revloop/main/schema/revloop.schema.json",
  "version": 1,
  "project": {
    "baseBranch": "main",
    "verify": ["npm run check:all"],
    "verifyNotes": "check:all does not run npm audit; CI runs it as its own job. Run `npm run audit` before pushing.",
    "branchPrefixes": ["feat", "fix", "docs", "chore", "ci", "test"],
    "commit": {
      "style": "conventional",
      "subjectLanguage": "en",
      "bodyLanguage": "en",
      "verifiedLabel": "Verified:",
      "trailers": ["Co-Authored-By: {model}"],
      "onePerRound": true
    },
    "pr": { "titleLanguage": "en" }
  },
  "defaults": { "reviewer": "codex", "maxRounds": 10, "timeout": "30m" }
}

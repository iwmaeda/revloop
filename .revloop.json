{
  "$schema": "https://raw.githubusercontent.com/iwmaeda/revloop/main/schema/revloop.schema.json",
  "version": 1,
  "project": {
    "baseBranch": "main",
    "verify": ["mise run check"],
    "verifyNotes": "`mise run check` does not run npm audit; CI runs it as its own job. Run `mise run audit` before pushing. A new worktree needs `mise trust` first.",
    "branchPrefixes": ["feat", "fix", "docs", "chore", "ci", "test"],
    "commit": {
      "style": "conventional",
      "subjectLanguage": "en",
      "bodyLanguage": "en",
      "verifiedLabel": "Verified:",
      "trailers": ["Co-Authored-By: {model}"],
      "onePerRound": true
    },
    "pr": {
      "titleLanguage": "en"
    }
  },
  "defaults": {
    "maxRounds": 10,
    "timeout": "30m"
  }
}

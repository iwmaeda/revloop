{
  "$schema": "https://raw.githubusercontent.com/iwmaeda/revloop/main/schema/revloop.schema.json",
  "version": 1,
  "project": {
    "verify": ["gofmt -l .", "go vet ./...", "go test ./..."],
    "branchPrefixes": ["feat", "fix", "docs", "chore"],
    "commit": { "style": "conventional", "subjectLanguage": "en" }
  },
  "defaults": { "reviewer": "codex", "maxRounds": 12 }
}

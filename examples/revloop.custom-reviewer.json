{
  "$schema": "https://raw.githubusercontent.com/iwmaeda/revloop/main/schema/revloop.schema.json",
  "version": 1,
  "project": {
    "baseBranch": "develop",
    "verify": ["make check", "make test"],
    "verifyNotes": "make check does not run the license scan; CI does that in a separate job",
    "commit": {
      "style": "conventional",
      "subjectLanguage": "ja",
      "scopes": ["api", "web", "infra"],
      "verifiedLabel": "検証:"
    },
    "pr": {
      "titleLanguage": "ja"
    }
  },
  "defaults": {
    "maxRounds": 15,
    "timeout": "45m"
  }
}

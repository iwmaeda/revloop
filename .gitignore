node_modules/
.DS_Store

# Per-developer agent state
.claude/settings.local.json
.claude/*.local.json

# Per-developer toolchain overrides (see mise.toml)
mise.local.toml

# Files the loop writes at runtime: field notes and grading input (see
# docs/design-notes.md). The procedure writes .revloop/.gitignore holding `*`
# before either, so git needs no rule here or in the repositories revloop is
# installed into. This one stays for prettier, which reads only the top-level
# .gitignore -- without it `format:check` would start reading .revloop/. The
# worktree ledger is NOT in .revloop/ -- it lives under the git directory.
.revloop/

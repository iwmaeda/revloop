.DS_Store

# Per-developer agent state
.claude/settings.local.json
.claude/*.local.json

# Per-developer toolchain overrides (see mise.toml)
mise.local.toml

# Files the loop writes at runtime: field notes and grading input (see
# docs/design-notes.md). The worktree ledger is NOT here -- it lives under the
# git directory, so that it needs no ignore rule in the repositories revloop is
# installed into, where this file has no reach.
.revloop/
